#include<stdio.h>
#include<stdlib.h>
struct node
{
    int data;
    struct node *next;
};
struct node *new, *top = NULL, *t, *head;
void pop()
{
    if (top == NULL)
        printf("Stack Underflow\n");
    else
    {
        t = top;
        top = top->next;
        free(t);
    }
}
void push(int x)
{
    new = (struct node *)malloc(sizeof(struct node));
    new->data = x;
    new->next = top;
    top = new;
}
void display()
{
     t = top;
     while (t != NULL)
     {
        printf("%d ", t->data);
        t = t->next;
    }
}
void create()
{
    int n, i, x;
    printf("Enter the number of node\n ");
    scanf("%d", &n);
    for (i = 0; i < n; i++)
    {
        printf("Enter the data\n");
        scanf("%d", &x);
        push(x);
    }
    printf("\n");
}
void main()
{
    create();
    display();
    push(10);
    push(20);
    push(30);
    push(40);
    display();
    pop();
    display();
    pop();
    display();
}
