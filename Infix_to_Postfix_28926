#include<stdio.h>
#define MAX 100

char stack[MAX];
int top = -1;

void push(char c) {
   stack[++top] = c;
}

char pop() {
   return stack[top--];
}
int priority(char c)
{
   if(c == '^')
    return 3;
   if(c == '*' || c == '/') 
   return 2;
   if(c == '+' || c == '-')
    return 1;
return 0;
}
int main() {
   char infix[MAX];
   int i, j = 0;
   char ch;
   printf("Enter infix expression: ");
   scanf("%s", infix);
   for(i = 0; infix[i] != '\0'; i++) {
      ch = infix[i];
      //Operand
      if ((ch >= 'a' && ch <= 'z') ||
      (ch >= 'A' && ch <= 'Z') ||
      (ch >= '0' && ch <= '9')) {
         printf("%c", ch);
      }
      // Opening bracket
      else if(ch == '(') {
         push(ch);
      }
      // Closing bracket
      else if(ch == ')') {
         while(top != -1 && stack[top] != '(') {
            printf("%c", pop());
         }
         pop(); // Remove '(' from stack
      }
      // Operator
      else {
         while(top != -1 && priority(stack[top]) >= priority(ch)) {
            printf("%c", pop());
         }
         push(ch);
      }
      
   }
   while(top != -1) {
      printf("%c", pop());
   }
   return 0;
}
