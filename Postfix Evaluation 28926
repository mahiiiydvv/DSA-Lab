#include<stdio.h>

int stack[100];
int top = -1;

void push(int c) {
    stack[++top] = c;
}
int pop() {
    return stack[top--];
}
int main(){
    char exp[100];
    int i,a,b,result;
    printf("Enter the postfix expression: ");
    scanf("%s", exp);
    for(i=0; exp[i]!='\0'; i++){
        if(isdigit(exp[i])){
            push(exp[i]-'0');
        } else {
            a = pop();
            b = pop();
            
            if(exp[i] == '+')
                result = b + a;
            else if(exp[i] == '-')
                result = b - a;
            else if(exp[i] == '*')
                result = b * a;
            else if(exp[i] == '/')
                result = b / a;
            
            push(result);
        }
    }printf("Result = %d\n", pop());
    return 0;
}
