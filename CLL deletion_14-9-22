#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

int main() {
    int ch = 1;
    struct node *head = NULL, *new = NULL, *temp = NULL;
    struct node *p = NULL, *t = NULL;

    while(ch == 1) {
        new = (struct node*)malloc(sizeof(struct node));

        printf("Enter the data part: ");
        scanf("%d", &new->data);

        if(head == NULL) {
            head = new;
            temp = new;
            temp->next = head;
        }
        else {
            temp->next = new;
            temp = temp->next;
            temp->next = head;
        }

        printf("Enter your choice as 0 or 1: ");
        scanf("%d", &ch);
    }

    int choice, element;

    printf("Enter your choice:\n");
    printf("\n1. deletion at beginning.");
    printf("\n2. deletion in between.");
    printf("\n3. deletion at last.\n");

    scanf("%d", &choice);

    if(head == NULL) {
        printf("List is empty.");
        return 0;
    }

    printf("Enter the data to delete: ");
    scanf("%d", &element);

    switch(choice) {

        case 1:
            if(head->next == head) {
                free(head);
                head = NULL;
            }
            else {
                p = head;

                while(p->next != head) {
                    p = p->next;
                }

                t = head;
                head = head->next;
                p->next = head;
                free(t);
            }
            break;

        case 2:
            p = head;
            t = head;

            if(head->data == element) {
                printf("Cannot delete head using this option.");
                break;
            }

            while(p->next != head && p->data != element) {
                t = p;
                p = p->next;
            }

            if(p->data == element) {
                t->next = p->next;
                free(p);
            }
            else {
                printf("Element not found.");
            }
            break;

        case 3:
            if(head->next == head) {
                free(head);
                head = NULL;
            }
            else {
                p = head;

                while(p->next != head) {
                    t = p;
                    p = p->next;
                }

                t->next = head;
                free(p);
            }
            break;

        default:
            printf("Invalid choice.");
    }

    if(head != NULL) {
        p = head;

        while(p->next != head) {
            printf("%d ", p->data);
            p = p->next;
        }

        printf("%d", p->data);
    }

    return 0;
}
