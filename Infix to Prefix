#include <stdio.h>

char stack[100];
int top = -1;

void push(char x)
{
    stack[++top] = x;
}

char pop()
{
    return stack[top--];
}

int priority(char x)
{
    if (x == '^')
        return 3;
    if (x == '*' || x == '/')
        return 2;
    if (x == '+' || x == '-')
        return 1;
    return 0;
}

int main()
{
    char infix[100], prefix[100];
    int i, j = 0;

    printf("Enter infix: ");
    scanf("%s", infix);

    for (i = strlen(infix) - 1; i >= 0; i--)
    {
        if (isalnum(infix[i]))
            prefix[j++] = infix[i];

        else if (infix[i] == ')')
            push(infix[i]);

        else if (infix[i] == '(')
        {
            while (top != -1 && stack[top] != ')')
                prefix[j++] = pop();

            pop();
        }

        else
        {
            while (top != -1 && priority(stack[top]) > priority(infix[i]))
                prefix[j++] = pop();

            push(infix[i]);
        }
    }

    while (top != -1)
        prefix[j++] = pop();

    prefix[j] = '\0';

    for (i = 0, j = strlen(prefix) - 1; i < j; i++, j--)
    {
        char temp = prefix[i];
        prefix[i] = prefix[j];
        prefix[j] = temp;
    }

    printf("Prefix: %s", prefix);

    return 0;
}
